    "contact.description" : {
      "comment" : "The reason why people want to contact us",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you couldn't find someone in the records but have information that might help with the search, please get in touch. You can also contact us if you have found information that may need correcting, such as a name, Japanese spelling, destination, ship, date, or other record detail. Please describe what you know in as much detail as you can."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録の中でお探しの方が見つからなかった場合でも、手がかりとなる情報をお持ちでしたら、ぜひご連絡ください。また、氏名、日本語表記、行き先、船名、日付など、記録に修正が必要と思われる情報を見つけた場合もお知らせください。お分かりになる範囲で、できるだけ詳しくご記入ください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não encontrou a pessoa que procura nos registros mas possui alguma informação que possa ajudar na busca, por favor, entre em contato. Você também pode nos escrever caso encontre informações que talvez precisem ser corrigidas, como nome, escrita em japonês, destino, navio, data ou outros dados do registro. Descreva o que você sabe com o máximo de detalhes possível."
          }
        }
      }
    },
    "contact.email" : {
      "comment" : "The person’s email",
