    "#%lld" : {
      "comment" : "A rank label that shows the rank of a prefecture in a statistics.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A description of the number of immigrants in a prefecture. The argument is the string “statistics.immigrants.lowercase”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
